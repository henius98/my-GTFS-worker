{
  "name": "my-gtfs-worker-test",
  "main": "../../worker/build/index.js",
  "compatibility_date": "2026-09-08",
  "vars": {
    "WORKER_TEST_NOW": "2026-09-24T00:00:00Z",
    "WORKER_CORS_ALLOW_ORIGIN": "*",
    "WORKER_SQL_MAX_ROWS": "1000",
    "WORKER_API_CACHE_TTL_SECONDS": "60",
    "WORKER_MAP_MAX_ROUTES": "20",
    "WORKER_MAP_CACHE_EXPIRE_TIME": "05:00",
    "WORKER_DEFAULT_TIMEZONE": "Asia/Kuala_Lumpur"
  },
  "d1_databases": [
    {
      "binding": "DB_KTMB",
      "database_name": "gtfs-worker-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../migrations/ktmb"
    },
    {
      "binding": "DB_RAPID_BUS_KL",
      "database_name": "gtfs-worker-rapid-bus-kl-test",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "../../migrations/rapid-bus-kl"
    }
  ]
}
