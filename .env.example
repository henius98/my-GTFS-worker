CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# Required runtime environment variables (set in server env, .env, GitHub vars, or Worker vars).
# Global D1 concurrency limit; also derives CSV producer concurrency (2x) and per-database concurrency (1x).
D1_CONCURRENCY_LIMIT=10
D1_MAX_DATABASES=10
D1_STATEMENTS_PER_REQUEST=8
# Shared daily D1 row-write ceiling enforced by 0_daily_import_budget (100,000 on D1 Free); each workflow leases up to this cap.
D1_DAILY_WRITE_LIMIT=100000
# Logical scan cap shared by every provider; actual writes are bounded separately.
MAX_ROWS_PER_WORKFLOW=5000000

MAX_FEED_DOWNLOAD_MB=256
MAX_UNCOMPRESSED_FEED_MB=512
MAX_FEED_ARCHIVE_ENTRIES=256
MAX_TEMP_FEED_STORAGE_MB=2048

MAX_CSV_RECORD_KB=512
MAX_STATEMENT_PAYLOAD_KB=1536
QUERY_STATEMENT_BATCH_SIZE=2000
DB_SIZE_THRESHOLD_MB=490

HTTP_CONNECT_TIMEOUT_SECS=10
HTTP_REQUEST_TIMEOUT_SECS=120
D1_QUERY_TIMEOUT_SECS=35
D1_MAX_QUERY_RETRIES=3
D1_MAX_RETRY_DELAY_SECS=30

# Worker CORS Access-Control-Allow-Origin header value (non-empty, e.g. "*" or a frontend origin).
WORKER_CORS_ALLOW_ORIGIN=*
# Worker SQL max rows; this is the maximum number of rows that can be returned in a single query to the worker.
WORKER_SQL_MAX_ROWS=1000
# Short edge Cache-Control max-age lifetime in seconds for /status and /data (non-negative integer).
WORKER_API_CACHE_TTL_SECONDS=60
# Feed-level cache lifetime in seconds for /map edge caching and /departures D1 departure_cache (positive integer).
WORKER_FEED_CACHE_TTL_SECONDS=86400
# Max distance in seconds from `now` for /departures requests to populate departure_cache (0 disables writes).
WORKER_DEPARTURE_CACHE_WINDOW_SECONDS=300
# Maximum and default `limit` values for /departures (1 <= default <= max).
WORKER_DEPARTURES_MAX_LIMIT=100
WORKER_DEPARTURES_DEFAULT_LIMIT=5
# Forward search horizon in days for /departures (positive integer).
WORKER_DEPARTURES_SEARCH_DAYS=7
# Fallback IANA timezone when a GTFS feed omits agency_timezone.
WORKER_DEFAULT_TIMEZONE=Asia/Kuala_Lumpur
