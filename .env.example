CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here
# Free-tier profile: use with at most two importer runs per UTC day.
CSV_CONCURRENCY_LIMIT=2
D1_CONCURRENCY_LIMIT=6
D1_DATABASE_CONCURRENCY_LIMIT=1
D1_MAX_DATABASES=10
D1_STATEMENTS_PER_REQUEST=4
# Hard importer-data write budget; two scheduled runs reserve 80% of D1 Free.
MAX_D1_ROWS_WRITTEN_PER_WORKFLOW=40000
# Logical scan cap shared by every provider; actual writes are bounded separately.
MAX_ROWS_PER_WORKFLOW=1750000
MAX_FEED_DOWNLOAD_MB=256
MAX_UNCOMPRESSED_FEED_MB=512
MAX_CSV_RECORD_KB=512
MAX_STATEMENT_PAYLOAD_KB=1536
MAX_TEMP_FEED_STORAGE_MB=2048
QUERY_STATEMENT_BATCH_SIZE=1000
DB_SIZE_THRESHOLD_MB=400
