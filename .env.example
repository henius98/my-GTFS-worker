CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here
# High scan concurrency; writes remain bounded by the shared daily ledger.
CSV_CONCURRENCY_LIMIT=20
D1_CONCURRENCY_LIMIT=10
D1_DATABASE_CONCURRENCY_LIMIT=8
D1_MAX_DATABASES=10
D1_STATEMENTS_PER_REQUEST=8
# Total workflow lease, including metadata; use the full 100,000 daily importer allowance.
MAX_D1_ROWS_WRITTEN_PER_WORKFLOW=100000
# Logical scan cap shared by every provider; actual writes are bounded separately.
MAX_ROWS_PER_WORKFLOW=5000000
MAX_FEED_DOWNLOAD_MB=256
MAX_UNCOMPRESSED_FEED_MB=512
MAX_CSV_RECORD_KB=512
MAX_STATEMENT_PAYLOAD_KB=1536
MAX_TEMP_FEED_STORAGE_MB=2048
QUERY_STATEMENT_BATCH_SIZE=2000
DB_SIZE_THRESHOLD_MB=490
