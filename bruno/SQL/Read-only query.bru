meta {
  name: Read-only query
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/{{provider}}/sql
  body: text
  auth: none
}

headers {
  Content-Type: text/plain
  Accept: application/json
  ~X-Admin-Key: 
}

body:text {
  SELECT stop_id, stop_name FROM stops LIMIT 10
}

docs {
  Send one SELECT query or a WITH ... SELECT query as plain text.
  Requires WORKER_ADMIN_KEY via Authorization: Bearer <key> or X-Admin-Key: <key>
  unless WORKER_ALLOW_ANONYMOUS_SQL=true is enabled locally.
  SQL comments and multiple statements are rejected. A trailing semicolon is allowed.
  Returns { data } capped at WORKER_SQL_MAX_ROWS (1000 in .env.example).
  Errors: 400 invalid query, 401 unauthorized, 403 admin key unconfigured, 404 unknown provider, 405 wrong method.
}
