meta {
  name: Network map
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/{{provider}}/map?route_id=KC05_KB18
  body: none
  auth: none
}

params:query {
  route_id: KC05_KB18
}

headers {
  Accept: application/json
}

docs {
  Returns the provider network as a GeoJSON FeatureCollection.
  Enable route_id to fetch one or more comma-separated routes (e.g. KC05_KB18,KA15_KD19, up to WORKER_MAP_MAX_ROUTES) and their stops; returns 404 if no requested route has active trips.
  LineString features represent route shapes or straight stop-to-stop segments;
  Point features represent stops. Successful responses are edge-cached per route for WORKER_FEED_CACHE_TTL_SECONDS.
}
