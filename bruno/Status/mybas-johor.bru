meta {
  name: mybas-johor status
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/mybas-johor/status
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  Generated from providers.toml by scripts/generate-bruno.py.
  Regenerate with: python3 scripts/generate-bruno.py
  Returns an array of import progress records; an empty array is valid.
  Fields: FileName, CRC, LastProcessedLine, LastProcessedByte, Status (0=COMPLETED, 1=IN_PROGRESS, 2=STAGED), UpdatedAt.
  Successful responses are edge-cached for WORKER_API_CACHE_TTL_SECONDS.
  Errors: 404 for an unbound provider; 429 on D1 row read limit; 500 for a database or response decoding error.
}
