{
  "name": "my-gtfs-worker",
  "version": "1.0.0",
  "packageManager": "pnpm@11.9.0",
  "description": "Cloudflare Worker GTFS importer",
  "main": "build/worker/shim.mjs",
  "scripts": {
    "build": "bash ./scripts/build.sh",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "import:local": "node scripts/local-d1-importer.mjs",
    "test:importer:local": "pnpm build && node --test test/importer/local_d1.test.mjs",
    "test:worker": "pnpm build && node --test test/worker/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.166.0"
  }
}
